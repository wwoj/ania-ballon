{% extends 'base.html.twig' %}

{% block title %}{{ "gallery.meta.title"|trans}}{% endblock %}

{% block meta_description %}
    {{ "gallery.meta.description"|trans}}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    </script>
    <script src="{{ asset('assets/js/gallery.js') }}"></script>
{% endblock %}

{% block body %}
<style>
.gallery-hero {
    position: relative;
    z-index: 1;
    isolation: isolate;
    margin-bottom: 34px;
    padding: 108px 24px 62px;
    text-align: center;
    background: linear-gradient(135deg, rgba(255, 246, 241, 0.98), rgba(255, 255, 255, 0.98));
    border-radius: 0 0 34px 34px;
    box-shadow: 0 18px 42px rgba(26, 43, 76, 0.08);
    overflow: hidden;
}

.gallery-hero__subtitle {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgb(255, 133, 161);
    margin-bottom: 10px;
    box-shadow: none;
    background-color: #fce7f3;
    padding: 0.5rem 1.5rem;
    border-radius: 21px;
}

.gallery-hero__title {
    max-width: 820px;
    margin: 0 auto 20px;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    color: #1a2b4c;
    font-weight: 800;
    line-height: 1.2;
}

.gallery-hero__lead {
    max-width: 760px;
    margin: 0 auto;
    font-size: 1.05rem;
    color: #555555;
    line-height: 1.7;
}

.gallery-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
}

.gallery-filter-btn {
    background: #f4f5f8;
    border: none;
    padding: 10px 22px;
    border-radius: 30px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #555555;
    cursor: pointer;
    transition: all 0.3s ease;
}

.gallery-filter-btn:hover,
.gallery-filter-btn.active {
    background: #ff6f61;
    color: #ffffff;
    box-shadow: 0 6px 15px rgba(255, 111, 97, 0.3);
}

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 25px;
    margin-bottom: 60px;
}

.gallery-card {
    border-radius: 20px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.gallery-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
}

.gallery-card__image-wrapper {
    position: relative;
    width: 100%;
    height: 320px;
    overflow: hidden;
}

.gallery-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.gallery-card:hover .gallery-card__img {
    transform: scale(1.08);
}

.gallery-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(26, 43, 76, 0.2) 0%, rgba(26, 43, 76, 0.85) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 25px;
    color: #ffffff;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.gallery-card:hover .gallery-card__overlay {
    opacity: 1;
}

.gallery-card__category {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #ffb36b;
    font-weight: 700;
    margin-bottom: 5px;
}

.gallery-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 15px;
}

.gallery-card__zoom-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    text-decoration: none;
    font-size: 1.1rem;
    transition: transform 0.2s ease;
}

.gallery-card__zoom-btn:hover {
    transform: scale(1.15);
}

.gallery-cta {
    background: linear-gradient(135deg, #1a2b4c 0%, #2b3e66 100%);
    color: #ffffff;
    padding: 50px 30px;
    border-radius: 24px;
    text-align: center;
    margin-bottom: 70px;
}

.gallery-cta h2 {
    font-size: 2rem;
    margin-bottom: 12px;
}

.gallery-cta p {
    font-size: 1.05rem;
    color: #d1d9e6;
    max-width: 600px;
    margin: 0 auto 25px auto;
}

.gallery-seo-text {
    padding: 60px 0;
    background-color: #fafbfc;
    border-top: 1px solid #eef0f5;
}

.gallery-seo-text h2 {
    font-size: 1.6rem;
    color: #1a2b4c;
    margin-bottom: 20px;
}

.gallery-seo-text__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    color: #666666;
    line-height: 1.7;
    font-size: 0.98rem;
}

@media (max-width: 768px) {
    .gallery-hero {
        margin-bottom: 24px;
        padding: 76px 18px 42px;
        border-radius: 0 0 24px 24px;
    }

    .gallery-hero__title {
        font-size: 2.1rem;
    }

    .gallery-seo-text__content {
        grid-template-columns: 1fr;
    }

    .gallery-card__image-wrapper {
        height: 260px;
    }
}

.grid-gallery {
    position: relative;
    z-index: 0;
    box-sizing: border-box;
    gap: 12px;
    display: grid;
    grid-auto-flow: dense;
    grid-auto-rows: 220px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    margin: 0 auto 70px;
    max-width: 1240px;
    padding: 0 24px;
    width: 100%;
}

.grid-gallery .grid-item:nth-child(3n-2) {
    grid-column: span 2;
    grid-row: span 2;
}

.grid-gallery .grid-item {
    background: #efefef;
    border-radius: 14px;
    box-shadow: 0 12px 30px rgba(26, 43, 76, 0.08);
    overflow: hidden;
    position: relative;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.grid-gallery .grid-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 38px rgba(26, 43, 76, 0.16);
}

.grid-gallery .grid-item__link {
    display: block;
    height: 100%;
    cursor: zoom-in;
    position: relative;
}

.grid-gallery .grid-item__image {
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(.165, .84, .44, 1);
    width: 100%;
}

.grid-gallery .grid-item:hover .grid-item__image,
.grid-gallery .grid-item__link:focus-visible .grid-item__image {
    transform: scale(1.08);
}

.grid-item__overlay {
    align-items: center;
    background: rgba(26, 43, 76, 0.28);
    color: #ffffff;
    display: flex;
    font-size: 1.8rem;
    inset: 0;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transition: opacity 0.3s ease;
}

.grid-gallery .grid-item:hover .grid-item__overlay,
.grid-gallery .grid-item__link:focus-visible .grid-item__overlay {
    opacity: 1;
}

@media (max-width: 768px) {
    .grid-gallery {
        gap: 8px;
        grid-auto-rows: 180px;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        padding: 0 14px;
    }
}
</style>

<div class="example-wrapper">
    <section class="gallery-hero">
        <div class="container">
            <span class="gallery-hero__subtitle">
            {{ ('gallery.' ~ title ~ '.subtitle')|trans|raw }}
            </span>
            <h1 class="gallery-hero__title">{{ ('gallery.' ~ title ~ '.title')|trans|raw }}</h1>
            <p class="gallery-hero__lead">
                {{ ('gallery.' ~ title ~ '.lead')|trans|raw }}
        </div>
    </section>

    <section class="grid-gallery" aria-label="Gallery images">
    {% for picture in pictures %}
        <div class="grid-item">
            <a class="grid-item__link " >
                <img class="grid-item__image" src="{{ asset('uploads/gallery/' ~ picture.image.filename) }}" alt="{{ picture.image.originalName }}" loading="lazy">
                <span class="grid-item__overlay" aria-hidden="true">
                    <i class="fa-solid fa-magnifying-glass-plus"></i>
                </span>
            </a>
        </div>
    {% endfor %}
    </section>

    <section class="gallery-seo-text">
        <div class="container">

            <h2>
                {{ ('gallery.' ~ title ~ '.seo_title')|trans|raw }}
            </h2>
            <div class="gallery-seo-text__content">
                <p>
                    {{ ('gallery.' ~ title ~ '.seo_description1')|trans|raw }}
                </p>
                <p>
                    {{ ('gallery.' ~ title ~ '.seo_description2')|trans|raw }}
                </p>
            </div>
        </div>
    </section>
</div>
{% include 'partials/_modal.html.twig' %}

{% endblock %}
