{% extends 'base_admin.html.twig' %}

{% block title %}Backdrops{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const GALLERY_TYPE = {{ galleryType.value }};
        const GALLERY_PATH = `{{ asset("uploads/gallery") }}`;
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script src="{{ asset('assets/js/admin-gallery.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/style/admin/gallery.css') }}">
{% endblock %}

{% block body %}
<div class="gallery example-wrapper">
    <h1>{{ title }}</h1>

    {% include 'partials/admin/_input_file.html.twig' %}
    {% include 'partials/admin/_upload_progress.html.twig' %}
    <hr/>
    <div>
        <button type="button" class="gallery__save-order-btn btn btn-outline-success" id="save-order">
            Save Order
        </button>
    </div>
    <hr/>

   <ul id="photos" aria-label="Backdrops order">

    {% for image in images %}
        <li class="photo" data-pg-id="{{ image.id }}" draggable="true">
            <span class="drag-handle">☰</span>
            <img src="{{ asset('uploads/gallery/' ~ image.image.filename) }}" alt="{{ image.image.originalName }}">
            <div>
                <div class="photo-name">
                    {{ image.image.originalName }}
                </div>
                <div class="photo-id">
                    {{ image.id }}
                </div>
            </div>
            <div class="photo__actions">
                <button
                    type="button"
                    class="photo__delete-btn"
                    title="Usuń zdjęcie"
                    aria-label="Usuń zdjęcie {{ image.image.originalName }}"
                >
                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                </button>
            </div>
        </li>
    {% endfor %}

   </ul>
</div>
{% endblock %}

