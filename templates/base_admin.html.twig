<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Ania Balloon - Dashboard{% endblock %}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('assets/style/admin/admin.css') }}">
    {% endblock %}
</head>
<body>
<div class="admin-layout">
    {% include 'partials/admin/_sidebar.html.twig' %}
    
    <div class="admin-layout__main">
        {% include 'partials/admin/_topbar.html.twig' %}

        <main class="admin-layout__content">
            {% block body %}
                <h1>Admin Dashboard</h1>
            {% endblock %}
        </main>
    </div>
</div>

    {% block javascripts %}
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

        <script src="{{ asset('assets/js/admin-sidebar.js') }}" defer></script>
    {% endblock %}
</body>
</html>