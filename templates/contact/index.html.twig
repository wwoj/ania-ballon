{% extends 'base.html.twig' %}

{% block title %}{{ "contact.meta.title"|trans }}{% endblock %}
{% block meta_description %}{{ "contact.meta.description"|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/contact_page.css') }}">
{% endblock %}

{% block body %}

{# 1. Hero Sekcji Kontakt #}
<section class="contact-hero">
    <div class="container">
        <span class="candy-badge">{{ 'contact.hero.badge'|trans }}</span>
        <h1>{{ 'contact.hero.title'|trans }}</h1>
        <p>{{ 'contact.hero.description'|trans }}</p>
    </div>
</section>

<div class="container contact-main-layout">

    {# 2. Sekcja Główna - Zamówienie Telefoniczne ze Zdjęciem #}
    <section class="contact-call-card">

        {# Przykładowe zdjęcie balonów z Unsplash #}
        <div class="contact-image-wrapper">
            <img src="https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=1000&q=80" alt="{{ 'contact.call.image_alt'|trans }}">
        </div>

        <h2>{{ 'contact.call.title'|trans }}</h2>
        <p class="call-lead">{{ 'contact.call.lead'|trans }}</p>

        <div class="phone-action-box">
            <a href="tel:+13120000000" class="btn-candy-call">
                <span class="btn-icon">📲</span>
                <span class="btn-text">
                    <small>{{ 'contact.call.button_label'|trans }}</small>
                    <strong>(312) 000-0000</strong>
                </span>
            </a>
            <a href="sms:+13120000000" class="btn-candy-sms">{{ 'contact.call.sms_button'|trans }}</a>
        </div>

        <div class="working-hours-badge">
            {{ 'contact.call.working_hours'|trans }}
        </div>
    </section>

    {# 3. Sekcja SEO Obszaru Działania (Sidebar) #}
    <aside class="contact-seo-info">

        <div class="seo-card">
            <h3>{{ 'contact.service_area.title'|trans }}</h3>
            <p>{{ 'contact.service_area.description'|trans|raw }}</p>

            <h4>{{ 'contact.service_area.list_title'|trans }}</h4>
            <ul class="cities-list">
                <li>{{ 'contact.service_area.chicago'|trans|raw }}</li>
                <li>{{ 'contact.service_area.wheaton'|trans|raw }}</li>
                <li>{{ 'contact.service_area.naperville_aurora'|trans }}</li>
                <li>{{ 'contact.service_area.schaumburg_elk_grove'|trans }}</li>
                <li>{{ 'contact.service_area.oak_brook_hinsdale'|trans }}</li>
                <li>{{ 'contact.service_area.des_plaines_park_ridge'|trans }}</li>
                <li>{{ 'contact.service_area.dupage'|trans }}</li>
                <li>{{ 'contact.service_area.cook'|trans }}</li>
            </ul>

            <div class="notice-box-candy">
                <p>{{ 'contact.service_area.notice'|trans|raw }}</p>
            </div>
        </div>

        <div class="seo-card">
            <h3>{{ 'contact.occasions.title'|trans }}</h3>
            <p>{{ 'contact.occasions.description'|trans }}</p>
            <ul class="services-seo-list">
                <li>{{ 'contact.occasions.birthdays'|trans|raw }}</li>
                <li>{{ 'contact.occasions.christening'|trans|raw }}</li>
                <li>{{ 'contact.occasions.baby_shower'|trans|raw }}</li>
                <li>{{ 'contact.occasions.backdrops'|trans|raw }}</li>
            </ul>
        </div>

    </aside>

</div>

{# 4. Sekcja FAQ #}
<section class="contact-faq-section container">
    <h2>{{ 'contact.faq.title'|trans }}</h2>
    <div class="faq-grid">
        <div class="faq-item">
            <h3>{{ 'contact.faq.advance.title'|trans }}</h3>
            <p>{{ 'contact.faq.advance.description'|trans }}</p>
        </div>
        <div class="faq-item">
            <h3>{{ 'contact.faq.setup.title'|trans }}</h3>
            <p>{{ 'contact.faq.setup.description'|trans }}</p>
        </div>
    </div>
</section>

{# 5. Struktura Schema.org (JSON-LD) #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "Ania Balloon",
  "image": "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=1000&q=80",
  "telephone": "+13120000000",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chicago",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "areaServed": [
    "Chicago",
    "Wheaton",
    "DuPage County",
    "Cook County",
    "Naperville",
    "Schaumburg"
  ],
    "description": {{ 'contact.schema.description'|trans|json_encode|raw }}
}
</script>

{% endblock %}