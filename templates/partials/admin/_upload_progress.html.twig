                <i class="fa-solid fa-xmark"></i>
            </button>
        </li>

        <li class="file-item">
            <div class="file-item__preview">
                <i class="fa-regular fa-image file-item__icon"></i>
            </div>
            <div class="file-item__details">
                <span class="file-item__name">scianka_komunia_02.png</span>
