<section id="kontakt" class="contact-section">
    <div class="container">
        <h2>{{ 'main.contact'|trans }}</h2>
        <div class="contact-grid">
            <div class="contact-map-card">
                <div class="map-placeholder">
                    <span class="location-badge">📍 Obszar obsługi: Metropolia Chicago i Suburbs</span>
                </div>
            </div>

            <div class="contact-form-card">
                <h3>Napisz do nas</h3>
                <form action="#" method="POST">
                    <div class="form-group">
                        <label for="name">Imię i Nazwisko</label>
                        <input type="text" id="name" name="name" placeholder="Twoje imię" required>
                    </div>
                    <div class="form-group">
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" placeholder="twoj@email.com" required>
                    </div>
                    <div class="form-group">
                        <label for="message">Wiadomość</label>
                        <textarea id="message" name="message" rows="4" placeholder="Opisz swoje wydarzenie..." required></textarea>
                    </div>
                    <button type="submit" class="btn-primary">Wyślij wiadomość</button>
                </form>
            </div>
        </div>
    </div>
</section>