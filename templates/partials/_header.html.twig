{% set current_route = app.request.attributes.get('_route') %}
{% set current_params = app.request.attributes.get('_route_params') %}


<header class="site-header">

    <div class="header-inner">

        <a href="#" class="logo" aria-label="Ania Balloons - strona główna">
            Ania Balloon
        </a>


        <nav class="main-nav" aria-label="Główna nawigacja">

            <a href="{{ path('home') }}" class="nav-link {{ current_route == 'home' ? 'active' : '' }}">
                {{ 'nav.home'|trans }}
            </a>

            <a href="{{ path('app_backdrop') }}" class="nav-link">
                {{ 'nav.backdrop'|trans }}
            </a>

            <a href="{{ path('app_animal') }}" class="nav-link">
                {{ 'nav.animal'|trans }}
            </a>

            <a href="{{ path('app_event') }}" class="nav-link">
                {{ 'nav.event'|trans }}
            </a>

            <a href="{{ path('contact') }}" class="nav-link {{ current_route == 'contact' ? 'active' : '' }}">
                {{ 'nav.contact'|trans }}
            </a>

        </nav>


        <div class="language-switcher">
    {% if app.request.locale == 'en' %}
        <span class="active">🇺🇸EN</span>|
        <a href="{{ path(current_route, current_params|merge({'_locale': 'pl'})) }}"> 
        🇵🇱
        PL
        </a>
    {% else %}
        <a href="{{ path(current_route, current_params|merge({'_locale': 'en'})) }}">🇺🇸EN</a>|
        <span class="active">🇵🇱PL
        </span>
    {% endif %}
</div>
        

    </div>
    

</header>
