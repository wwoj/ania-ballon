<section class="services">

    <div class="services-header">

        <span class="services-eyebrow">
            {{ 'services.whatWeDo'|trans }}
        </span>

        <h2>
            {{ 'services.title'|trans }}
        </h2>

        <p>
            {{ 'services.description'|trans }}
        </p>

    </div>


    <div class="services-grid">

        {# ==================================================
           1. BALLOON GARLANDS AND BACKDROPS
        ================================================== #}

        <a href="#" class="service-card">

            <div class="service-image">

                <img
                    src="https://lirp.cdn-website.com/29e01c2a/dms3rep/multi/opt/PCI%2BCompliance%2BSimplified%2Bfor%2BBalloon%2BDecor%2BBusinesses%2B-1920w.jpg"
                    alt="{{ 'services.garlandsAndBackdropsAlt'|trans }}"
                    loading="lazy"
                >

            </div>


            <div class="service-content">

                <span class="service-number">
                    01
                </span>

                <h3>
                    {{ 'services.garlandsAndBackdrops'|trans }}
                </h3>

                <p>
                {{ 'services.garlandsAndBackdropsDescription'|trans }}
                </p>

                <span class="service-link">
                    {{ 'services.learnMore'|trans }}
                    <span aria-hidden="true">→</span>
                </span>

            </div>

        </a>


        {# ==================================================
           2. Animal Balloons
        ================================================== #}

        <a href="#" class="service-card">

            <div class="service-image">

                <img
                    src="https://storage.googleapis.com/dniweohakwkrne/zoo-balloons-party-decorations.html"
                    alt="{{ 'services.animalBalloonsAlt'|trans }}"
                    loading="lazy"
                >

            </div>


            <div class="service-content">

                <span class="service-number">
                    02
                </span>

                <h3>
                {{ 'services.animalBalloons'|trans }}<br>
                </h3>

                <p>
                    {{ 'services.animalBalloonsDescription' |trans }}
                </p>

                <span class="service-link">
                    {{ 'services.learnMore'|trans }}
                    <span aria-hidden="true">→</span>
                </span>

            </div>

        </a>


        {# ==================================================
           3. DECORATION FOR EVENTS
        ================================================== #}

        <a href="#" class="service-card">

            <div class="service-image">

                <img
                    src="https://partyboxto.com/cdn/shop/products/Untitled-6.jpg?v=1629769938"
                    alt="{{ 'services.eventDecorationsAlt'|trans }}"
                    loading="lazy"
                >

            </div>


            <div class="service-content">

                <span class="service-number">
                    03
                </span>

                <h3>
                    {{ 'services.eventDecorations'|trans }}
                </h3>

                <p>
                    Przygotowujemy dekoracje balonowe na eventy,
                    imprezy firmowe, urodziny, otwarcia oraz inne
                    wydarzenia wymagające wyjątkowej oprawy.
                </p>

                <span class="service-link">
                    {{ 'services.learnMore'|trans }}
                    <span aria-hidden="true">→</span>
                </span>

            </div>

        </a>

    </div>

</section>
