<section class="service-area">

    <div class="service-area-header">

        <span class="service-area-eyebrow">
        {{ 'serviceArea.whereWeWork'|trans }}
        </span>

        <h2>
        {{ 'serviceArea.title'|trans }}
        </h2>

        <p>
            {{ 'serviceArea.description1'|trans }}
        </p>

        <p>
            {{ 'serviceArea.description2'|trans }}
        </p>

    </div>


    <div class="service-area-content">

        {# MAP #}
        <div class="service-area-map">

            <div class="map-placeholder">

                <span class="map-label">
                {{ 'serviceArea.mapLabel'|trans }}
                </span>

                <div class="map-marker map-marker-chicago">
                    Chicago
                </div>

                <div class="map-marker map-marker-naperville">
                    Naperville
                </div>

                <div class="map-marker map-marker-wheaton">
                    Wheaton
                </div>

            </div>

        </div>


        {# Contact #}
        <div class="service-area-contact">

            <span class="service-area-contact-eyebrow">
                {{ 'serviceArea.haveQuestions'|trans }}
            </span>

            <h3>
                {{ 'serviceArea.talkToUs'|trans }}
            </h3>

            <p>
                {{ 'serviceArea.contactDescription'|trans }}
            </p>

            <div class="contact-person">

                <div class="contact-person-icon">
                    A
                </div>

                <div>
                    <span>
                    {{ 'serviceArea.contactWith'|trans }}
                    </span>

                    <strong>
                        Ania
                    </strong>
                </div>

            </div>


            <a
                href="tel:+1XXXXXXXXXX"
                class="contact-phone"
            >
                +1 XXX XXX XXXX
            </a>

            <a href="#" class="contact-button">
                {{ 'serviceArea.requestQuote'|trans }}
            </a>

        </div>

    </div>

</section>
