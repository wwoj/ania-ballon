<section class="about">

    <div class="about-image">

        <img
            src="https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=1200&q=85"
            alt="Dekoracje balonowe na przyjęcie"
            loading="lazy"
        >

        <div class="about-image-badge">
            <span>ANIA</span>
            <strong>Balloons</strong>
        </div>

    </div>


    <div class="about-content">

        <span class="about-eyebrow">
        {{ 'about.getToKnowUs'|trans }}
        </span>

        <h2>
            {{ 'about.title'|trans }}
        </h2>

        <p class="about-lead">
            {{ 'about.description1'|trans }}
        </p>

        <p>
            {{ 'about.description2'|trans }}
        </p>

        <p>
            {{ 'about.description3'|trans }}
        </p>

        <div class="about-highlights">
            <div class="about-highlight">
                <span class="about-highlight__icon"><i class="fa-solid fa-gem" aria-hidden="true"></i></span>
                <span><strong>Najwyższa jakość</strong><small>Profesjonalne, trwałe balony</small></span>
            </div>
            <div class="about-highlight">
                <span class="about-highlight__icon"><i class="fa-solid fa-palette" aria-hidden="true"></i></span>
                <span><strong>Twój pomysł</strong><small>Projekt dopasowany do okazji</small></span>
            </div>
            <div class="about-highlight">
                <span class="about-highlight__icon"><i class="fa-solid fa-truck-fast" aria-hidden="true"></i></span>
                <span><strong>Pełna opieka</strong><small>Dowóz, montaż i demontaż</small></span>
            </div>
        </div>

        <a href="#" class="about-button">
            {{ 'learnMore'|trans }}
            <span aria-hidden="true">→</span>
        </a>

    </div>

</section>
