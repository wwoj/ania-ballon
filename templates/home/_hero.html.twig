<section class="hero">

    <div class="hero-image" aria-hidden="true"></div>

    <div class="hero-content">

        <div class="hero-text">

            <span class="hero-eyebrow">
                <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                Magia w każdym detalu
            </span>

            <h1>
                {{ 'hero.title'|trans|raw }}
            </h1>

            <p>
                {{ 'hero.subtitle'|trans }}
            </p>

            <div class="hero-actions">
                <a href="{{ path('contact') }}" class="hero-button hero-button--secondary">
                    <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                    {{ 'hero.button_text'|trans }}
                </a>
                <a href="{{ path('gallery') }}" class="hero-button hero-button--secondary">
                    <i class="fa-solid fa-images" aria-hidden="true"></i>
                    Zobacz galerię
                </a>
            </div>

            <div class="hero-trust">
                <span><i class="fa-solid fa-star" aria-hidden="true"></i> Dekoracje z charakterem</span>
                <span><i class="fa-solid fa-heart" aria-hidden="true"></i> Chicago i okolice</span>
            </div>

        </div>

    </div>

</section>
