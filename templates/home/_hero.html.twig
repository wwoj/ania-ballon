<section class="hero">

    <div class="hero-image" aria-hidden="true"></div>

    <div class="hero-content">

        <div class="hero-text">

            <h1>
                {{ 'hero.title'|trans|raw }}
            </h1>

            <p>
                {{ 'hero.subtitle'|trans }}
            </p>

            <a href="#" class="hero-button">
                {{ 'hero.button_text'|trans }}
            </a>

        </div>

    </div>

</section>
